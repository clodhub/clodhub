{
  "name": "clodhub",
  "private": true,
  "version": "0.1.0",
  "description": "ClodHub: the catalogue of reviewed components and recipes that AI agents assemble into apps with clod",
  "workspaces": [
    "shared",
    "worker",
    "site"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build -w site",
    "smoke": "node scripts/smoke.mjs",
    "render-diagrams": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/render-diagrams.ts",
    "validate-recipe": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-recipe-file.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261118.1": true,
    "workerd@1.20261119.1": true
  }
}
