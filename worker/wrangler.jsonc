{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app-game-store",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/assets/*.js"] }],
  "routes": [
    { "pattern": "ourapps.app", "custom_domain": true },
    { "pattern": "*.ourapps.app/*", "zone_name": "ourapps.app" }
  ],
  "workers_dev": false,
  "kv_namespaces": [
    { "binding": "WEBAPP_FILES", "id": "78d1938eff3947f1ad4a932368e36035" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "app-game-store", "database_id": "5b0d8d7d-eae4-4bdb-967a-9bb1c49e076c", "migrations_dir": "migrations" }
  ],
  // Catalogue documents (one per published version) and images by sha256.
  "r2_buckets": [
    { "binding": "CATALOGUE", "bucket_name": "ourapps-catalogue" }
  ],
  "assets": {
    "directory": "../site/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    // Public origin of this deployment; OAuth callbacks and links are built from it.
    "PUBLIC_ORIGIN": "https://ourapps.app",
    "APPLE_API_BASE": "https://api.appstoreconnect.apple.com",
    "GITHUB_API_BASE": "https://api.github.com",
    "GITHUB_OAUTH_BASE": "https://github.com",
    // Google Search Console HTML file name, for example google1234abcd.html; blank disables the route.
    "GOOGLE_SITE_VERIFICATION": "",
    // GitHub logins, comma-separated, whose catalogue publish calls may set a version's quality level.
    "CATALOGUE_CURATORS": "george-mcintyre",
    "OSV_API_BASE": "https://api.osv.dev"
  },
  // Every 10 minutes: TestFlight. Hourly at 07: the vulnerability check of purls not checked for a day.
  // Daily at 03:17: the 30-day download counts and trending.
  "triggers": { "crons": ["*/10 * * * *", "7 * * * *", "17 3 * * *"] },
  "observability": { "enabled": true }
}
