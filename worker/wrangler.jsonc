{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clodhub",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "clodhub.com", "custom_domain": true }],
  "workers_dev": false,
  "d1_databases": [
    { "binding": "DB", "database_name": "clodhub", "database_id": "52511f94-bc20-421a-846c-a0553f32e7f3", "migrations_dir": "migrations" }
  ],
  // Catalogue documents (one per published version) and images by sha256.
  "r2_buckets": [
    { "binding": "CATALOGUE", "bucket_name": "clodhub-catalogue" }
  ],
  "assets": {
    "directory": "../site/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    // Public origin of this deployment; OAuth callbacks and links are built from it.
    "PUBLIC_ORIGIN": "https://clodhub.com",
    "GITHUB_API_BASE": "https://api.github.com",
    "GITHUB_OAUTH_BASE": "https://github.com",
    // Numeric GitHub user ids, comma-separated, who may set quality and publish the category tree (5442914: george-mcintyre).
    "CATALOGUE_CURATORS": "5442914",
    // Namespaces assigned to GitHub owners (namespace=owner, comma-separated); io.github.<owner> needs no entry.
    "NAMESPACE_OWNERS": "com.clodhub=clodhub",
    "OSV_API_BASE": "https://api.osv.dev"
  },
  // Hourly at 07: the vulnerability check of purls not checked for a day, the day's download refresh in chunks, and the
  // removal of images nobody named within a day.
  "triggers": { "crons": ["7 * * * *"] },
  "observability": { "enabled": true }
}
